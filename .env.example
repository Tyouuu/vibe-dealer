# Supabase project — Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Used for reconciliation-statement OCR (src/app/api/reconcile/extract).
ANTHROPIC_API_KEY=

# Used to email the daily report (src/app/api/cron/daily-report).
RESEND_API_KEY=

# Address the daily report is sent from. Must be on a domain verified in
# Resend (Domains > Add Domain, then add the DKIM/SPF records it gives you).
# Left unset, the report falls back to Resend's shared onboarding@resend.dev,
# which only delivers to the Resend account owner — fine for one person
# testing, silently broken as soon as there is a second master.
REPORT_FROM_EMAIL=

# Shared secret the daily-report cron request must present — generate with
# `openssl rand -hex 32` and set the same value in the Vercel Cron config.
CRON_SECRET=
